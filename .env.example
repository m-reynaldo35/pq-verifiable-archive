# Set NODE_ENV=production on hosted deployments. In production the server
# refuses to start without PORTAL_API_KEY, X402_TREASURY_ADDRESS and a
# consistent ML-DSA key pair.
NODE_ENV=

# Mainnet (production) — switch to testnet URLs for local dev if needed
ALGORAND_NODE_URL=https://mainnet-api.algonode.cloud
ALGORAND_INDEXER_URL=https://mainnet-idx.algonode.cloud

# Issuer wallet: signs anchor and key-registration txns. Its address is the
# issuer address verifiers pin. Generated by scripts/generate-wallet.ts.
ALGORAND_MNEMONIC=

# Issuer ML-DSA-65 keys, from scripts/register-key.ts. Held by the operator of
# this service (the DOCUSIGN_* names are still read as deprecated aliases).
PQVA_MLDSA_PUBLIC_KEY=
PQVA_MLDSA_PRIVATE_KEY=
PQVA_KEY_REGISTRATION_TXN_ID=

# Trust anchor used by this server's /api/verify and the MCP verify_bundle tool.
# Leave unset to trust the hosted service's issuer; self-hosters set their own
# (scripts/register-key.ts prints these values).
PQVA_TRUSTED_ISSUER_ADDRESS=
PQVA_TRUSTED_KEY_REG_TXN_ID=
PQVA_TRUSTED_PK_SHA256=

# Operator API key for /api/archive and /api/documents/* (x-api-key header or
# "Authorization: Bearer <key>"). Required in production.
PORTAL_API_KEY=

# Persistent storage for archived PDFs/bundles. Point at a mounted volume.
PQVA_ARCHIVE_DIR=

# Number of reverse-proxy hops in front of the server (1 on Railway; defaults
# to 1 when RAILWAY_ENVIRONMENT_NAME is set, else 0).
TRUST_PROXY_HOPS=

# DocuSign Connect integration
DOCUSIGN_HMAC_KEY=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_INTEGRATION_KEY=
DOCUSIGN_USER_ID=
DOCUSIGN_PRIVATE_KEY=   # RSA private key PEM, base64-encoded
DOCUSIGN_SANDBOX=true

# When true (and NODE_ENV is not production), an inline base64 test PDF in the
# webhook body bypasses the DocuSign download so the pipeline can run without
# DocuSign credentials.
DOCUSIGN_ALLOW_TEST_PDF=false
PORT=3000

# x402 payment gate for /api/anchor. Required in production.
X402_TREASURY_ADDRESS=               # Algorand address that receives USDC per anchor
X402_TOLL_USD=$0.01                  # Price per anchor (default $0.01)
X402_FACILITATOR_URL=https://facilitator.goplausible.xyz   # SDK default; swap for self-hosted

# MCP server: maximum anchor_document calls per UTC day (default 25)
MCP_MAX_ANCHORS_PER_DAY=25
